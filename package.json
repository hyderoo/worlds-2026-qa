{
  "name": "worlds-2026-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end and API test suite for Worlds 2026 Live",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=desktop-chrome --project=mobile-chrome",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "summary": "node scripts/summarize.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "zod": "^3.23.0"
  }
}
